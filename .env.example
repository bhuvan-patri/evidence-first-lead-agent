# Required production LLM
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional validated-search fallback
TAVILY_API_KEY=

# Optional runtime tuning
MAX_PAGES=5

# Optional cost tracking. Set these to the Gemini rates for the exact model,
# account, and region you use; values are USD per 1,000,000 tokens.
GEMINI_INPUT_USD_PER_1M_TOKENS=
GEMINI_OUTPUT_USD_PER_1M_TOKENS=
GEMINI_THOUGHT_USD_PER_1M_TOKENS=
